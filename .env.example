MANUSCRIPT_ROOT=/absolute/path/to/my/book
# Optional comma-separated additions to the default HTTP Host allowlist.
# Defaults already include 127.0.0.1, localhost, *.trycloudflare.com, *.ngrok-free.app, *.ngrok-free.dev, and *.ngrok.app.
MANUSCRIPT_ALLOWED_HOSTS=
# Optional. Leave unset/0 for ChatGPT stability; the browser extension image-save endpoint does not need these MCP tools.
MANUSCRIPT_ENABLE_IMAGE_MCP_TOOLS=0
